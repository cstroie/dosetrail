[Unit]
Description=Dozimetrix HIS lookups (patient, weight, height, imaging request)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=dosimetrix
Group=dosimetrix
WorkingDirectory=/opt/dosimetrix
ExecStart=/opt/dosimetrix/.venv/bin/dosimetrix his run
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dosimetrix

[Install]
WantedBy=multi-user.target
