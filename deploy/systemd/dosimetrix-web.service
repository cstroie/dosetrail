[Unit]
Description=Dosimetrix web UI and API
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=dosimetrix
Group=dosimetrix
WorkingDirectory=/opt/dosimetrix
ExecStart=/opt/dosimetrix/.venv/bin/dosimetrix serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dosimetrix

[Install]
WantedBy=multi-user.target
