[Unit]
Description=Dozimetrix web UI and API
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=dozimetrix
Group=dozimetrix
WorkingDirectory=/opt/dozimetrix
ExecStart=/opt/dozimetrix/.venv/bin/dozimetrix serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dozimetrix

[Install]
WantedBy=multi-user.target
