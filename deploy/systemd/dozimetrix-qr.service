[Unit]
Description=Dozimetrix PACS query/retrieve loop (last two days, every 12 minutes)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=dozimetrix
Group=dozimetrix
WorkingDirectory=/opt/dozimetrix
Environment=QR_ARGS="--days 2 --interval 720"
EnvironmentFile=-/etc/default/dozimetrix
ExecStart=/opt/dozimetrix/.venv/bin/dozimetrix $DOZIMETRIX_OPTS qr --loop $QR_ARGS
# SIGTERM lets the current run finish
TimeoutStopSec=300
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/dozimetrix

[Install]
WantedBy=multi-user.target
