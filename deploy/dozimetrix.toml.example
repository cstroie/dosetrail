# /etc/dozimetrix/dozimetrix.toml  (mode 0640, owner root:dozimetrix)

[database]
url = "mysql+pymysql://dozimetrix:CHANGE-ME@localhost/dozimetrix?charset=utf8mb4"
# test_url = "mysql+pymysql://dozimetrix:CHANGE-ME@localhost/dozimetrix_test?charset=utf8mb4"   # optional: the test suite also runs on this scratch DB (it is wiped)

[security]
secret_file = "/var/lib/dozimetrix/secret"   # created on first start; back it up
session_hours = 12
secure_cookies = true                        # force Secure cookies (HTTPS-only logins);
                                             # without it they are Secure whenever the
                                             # request arrived over HTTPS

[web]
host = "127.0.0.1"                           # 0.0.0.0 to listen on every interface
port = 8104                                  # "80" for HTTP + "104" for DICOM
trusted_proxies = ["127.0.0.1"]              # reverse proxies allowed to set X-Forwarded-*
# allowed_hosts = ["dose.example.org"]       # refuse other Host headers (empty = any)
# max_upload_mb = 50                          # largest request body under /api/

[dicom]
aet = "DOZIMETRIX"
port = 11112                                 # the IANA-registered DICOM port
bind = "0.0.0.0"
allowed_aets = []                            # e.g. ["CT1", "PACS"]; empty = any caller
spool_dir = "/var/lib/dozimetrix/spool"
keep_received = false
# max_object_mb = 2048                       # larger objects are refused
# min_free_mb = 1024                         # refuse objects when the spool disk is this full
# retention_days = 90                        # remove spool failed/ and archive/ files older than this (default 0 = keep)

[pacs]
host = "pacs.example.org"
port = 104
aet = "PACS_AET"
retrieve = "get"                             # get (C-GET, no PACS setup) | move (C-MOVE)
# move_destination = "DOZIMETRIX"             # C-MOVE target AE; the PACS must know it
modalities = ["CT", "DX", "CR", "RF", "XA", "MG", "SR"]   # queried one at a time
# max_results = 500                          # the PACS's C-FIND cap; days are split if hit

[notify]
# Alert notifications (rules with "notify" on, studies from the last 48 h). Messages carry
# no patient identifiers, only a link to the study (login needed). What an admin sets in the
# web UI (Admin > Alerts > Notifications) overrides these values, field by field.
# base_url is the site's web address: Admin > Settings overrides it.
base_url = "https://dose.example.org"
# e-mail
# email_to = ["physics@example.org"]
# email_from = "dozimetrix@example.org"
# smtp_host = "smtp.example.org"
# smtp_port = 587
# smtp_starttls = true
# smtp_user = "dozimetrix"
# smtp_password_file = "/etc/dozimetrix/smtp-password"   # mode 0600
# ntfy (https://ntfy.sh or a self-hosted server)
# ntfy_url = "https://ntfy.example.org/dozimetrix-alerts"
# ntfy_token_file = "/etc/dozimetrix/ntfy-token"         # optional, mode 0600
